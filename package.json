{
  "name": "restaurant-website",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24.15.0 <25" },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w frontend",
    "reservations": "node backend/scripts/reservations.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
